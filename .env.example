# Scholia API configuration.
#
# Copy to .env for local development. In production these are set as real
# environment variables — do not ship a .env into the image.

# ---------------------------------------------------------------------------
# User data: Supabase Postgres
# ---------------------------------------------------------------------------
# Supabase Dashboard -> Project Settings -> Database -> Connection string.
#
# Pick the endpoint that matches your platform:
#
#   Session pooler   (recommended for a long-lived Go server)
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   Transaction pooler (serverless / very short-lived processes). Server-side
#   prepared statements do not survive it, so the exec mode must be forced:
#     postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?default_query_exec_mode=simple_protocol
#
#   Direct connection is IPv6-only on the free tier and unreachable from most
#   container platforms. Prefer a pooler.
#
# The API refuses to start on a :6543 DSN without the exec-mode parameter,
# rather than failing intermittently once under load.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Connection pool sizing. Supabase enforces per-project connection ceilings, so
# these should stay small when running several containers.
# SCHOLIA_DB_MAX_OPEN_CONNS=10
# SCHOLIA_DB_MAX_IDLE_CONNS=5

# ---------------------------------------------------------------------------
# Supabase Auth
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefghijkl.supabase.co
# Used to derive the expected token issuer and the JWKS endpoint.
SUPABASE_URL=https://<project-ref>.supabase.co

# No Supabase API key is required by this server.
#
# Sign-up, sign-in, OAuth, refresh and password reset happen directly between
# the client and Supabase. The API only verifies access tokens, against public
# keys. It never acts on a user's behalf, so it holds no Supabase credential —
# the publishable key belongs in the frontend, and the secret key is not used.

# Optional. Access tokens are verified locally against the project's public
# signing keys, fetched from this endpoint and refreshed in the background.
#
# Defaults to $SUPABASE_URL/auth/v1/.well-known/jwks.json. Supabase has served
# these from more than one path; set this only if the default 404s.
# SUPABASE_JWKS_URL=

# ---------------------------------------------------------------------------
# Bible corpus
# ---------------------------------------------------------------------------
# Path to the read-only SQLite corpus. Defaults to ./data/bible.db, resolved
# against the working directory and its ancestors. The Dockerfile sets this to
# the baked-in absolute path.
# SCHOLIA_DB_PATH=/app/data/bible.db

# HTTP port. Defaults to 8080.
# PORT=8080
